<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:clipChildren="false"
    android:clipToPadding="false">

    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cameraViewGroup"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:background="@drawable/bg_main"
        android:elevation="18dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.32"
        app:layout_constraintHorizontal_bias="1.0">

        <ImageView
            android:id="@+id/ivCameraViewClose"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="11dp"
            android:layout_margin="4dp"
            android:src="@drawable/ic_close"
            android:background="@drawable/bg_glass_icon_button"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:tint="@color/white" />

        <androidx.constraintlayout.utils.widget.ImageFilterView
            android:id="@+id/bgGlass"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="14dp"
            android:src="@drawable/bg_camera_glass_frame"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="398:430"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:round="20dp" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cvCamera"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="28.6dp"
            app:cardUseCompatPadding="false"
            app:layout_constraintBottom_toBottomOf="@id/bgGlass"
            app:layout_constraintEnd_toEndOf="@id/bgGlass"
            app:layout_constraintStart_toStartOf="@id/bgGlass"
            app:layout_constraintTop_toTopOf="@id/bgGlass">

            <androidx.camera.view.PreviewView
                android:id="@+id/camera_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:implementationMode="compatible"
                app:scaleType="fillCenter" />

            <ImageView
                android:id="@+id/camera_output_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

        </androidx.cardview.widget.CardView>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/bgGlass"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@id/bgGlass"
            app:layout_constraintEnd_toEndOf="@id/bgGlass">

            <TextView
                android:id="@+id/btnKLT"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_glass_chip"
                android:gravity="center"
                android:text="KLT"
                android:textColor="@color/white"
                android:textSize="18sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnFBVector"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHorizontal_chainStyle="spread" />

            <TextView
                android:id="@+id/btnFBVector"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/bg_glass_chip"
                android:gravity="center"
                android:text="Fb Vector"
                android:textColor="@color/white"
                android:textSize="14sp"
                app:layout_constraintStart_toEndOf="@id/btnKLT"
                app:layout_constraintEnd_toStartOf="@id/btnFBHeatmap"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <TextView
                android:id="@+id/btnFBHeatmap"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_glass_chip"
                android:gravity="center"
                android:text="Fb Heatmap"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:layout_constraintStart_toEndOf="@id/btnFBVector"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageView
        android:id="@+id/ivBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/bg_glass_icon_button"
        android:padding="12dp"
        android:scaleX="-1"
        android:src="@drawable/ic_close"
        android:translationZ="100dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/tvSpeed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_chip"
        android:gravity="center"
        android:text="50km/h"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:textColor="@color/gnt_red"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"
        app:layout_constraintStart_toStartOf="@id/ivBack"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <ImageView
        android:id="@+id/ivShowCameraView"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_glass_icon_button"
        android:padding="12dp"
        android:scaleX="-1"
        android:src="@drawable/ic_arrow_right"
        android:translationZ="100dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/cameraViewGroup"
        app:tint="@color/black" />

</androidx.constraintlayout.widget.ConstraintLayout>
