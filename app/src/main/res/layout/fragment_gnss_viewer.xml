<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <android.opengl.GLSurfaceView
        android:id="@+id/myGLSurfaceView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <com.example.gnssandopticalflowapp.util.liquidglass.widget.LiquidGlassView
        android:id="@+id/searchBubble"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@id/searchBar"
        app:layout_constraintEnd_toEndOf="@id/searchBar"
        app:layout_constraintStart_toStartOf="@id/searchBar"
        app:layout_constraintTop_toTopOf="@id/searchBar" />

    <LinearLayout
        android:id="@+id/searchBar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="42dp"
        android:elevation="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivSearchIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_search_24"
            android:tint="@color/black"/>

        <EditText
            android:id="@+id/etSearchLocation"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:ellipsize="end"
            android:fontFamily="@font/inter_bold"
            android:hint="Search location"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:padding="0dp"
            android:singleLine="true"
            android:textColor="@color/black"
            android:textColorHint="@color/black"
            android:textCursorDrawable="@drawable/cursor_gnss_search_black"
            android:textSize="15sp" />

        <com.example.gnssandopticalflowapp.util.liquidglass.widget.LiquidGlassView
            android:id="@+id/cancelBubble"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@id/ivSearchClear"
            app:layout_constraintEnd_toEndOf="@id/ivSearchClear"
            app:layout_constraintStart_toStartOf="@id/ivSearchClear"
            app:layout_constraintTop_toTopOf="@id/ivSearchClear" />

        <ImageView
            android:id="@+id/ivSearchClear"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="11dp"
            android:src="@drawable/ic_close"
            android:visibility="gone"/>

    </LinearLayout>

    <com.example.gnssandopticalflowapp.util.liquidglass.widget.LiquidGlassView
        android:id="@+id/chooseOnMapBubble"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@id/chooseOnMapBar"
        app:layout_constraintEnd_toEndOf="@id/chooseOnMapBar"
        app:layout_constraintStart_toStartOf="@id/chooseOnMapBar"
        app:layout_constraintTop_toTopOf="@id/chooseOnMapBar" />

    <LinearLayout
        android:id="@+id/chooseOnMapBar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="10dp"
        android:elevation="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:visibility="gone"
        android:paddingEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchBar">

        <ImageView
            android:id="@+id/ivChoose"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_target_location"
            android:tint="@color/black"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_bold"
            android:maxLines="1"
            android:layout_marginStart="12dp"
            android:padding="0dp"
            android:textSize="15sp"
            android:singleLine="true"
            android:textColor="@color/black"
            android:text="Choose on map"/>

    </LinearLayout>
    <Space
        android:id="@+id/searchMaxHeight"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chooseOnMapBar" />

    <com.example.gnssandopticalflowapp.util.liquidglass.widget.LiquidGlassView
        android:id="@+id/resultBubble"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="-6dp"
        android:layout_marginBottom="-6dp"
        app:layout_constraintBottom_toBottomOf="@id/searchResultsPanel"
        app:layout_constraintEnd_toEndOf="@id/searchResultsPanel"
        app:layout_constraintStart_toStartOf="@id/searchResultsPanel"
        app:layout_constraintTop_toTopOf="@id/searchResultsPanel" />

    <ScrollView
        android:id="@+id/searchResultsPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:elevation="14dp"
        android:fadeScrollbars="false"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:scrollbars="vertical"
        android:visibility="gone"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="@id/searchMaxHeight"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chooseOnMapBar"
        app:layout_constraintVertical_bias="0.0">

        <LinearLayout
            android:id="@+id/searchResultsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="6dp" />

    </ScrollView>

    <com.example.gnssandopticalflowapp.util.liquidglass.widget.LiquidGlassView
        android:id="@+id/navigationBubble"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@id/routeBottomBar"
        app:layout_constraintEnd_toEndOf="@id/routeBottomBar"
        app:layout_constraintStart_toStartOf="@id/routeBottomBar"
        app:layout_constraintTop_toTopOf="@id/routeBottomBar" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/routeBottomBar"
        android:layout_width="0dp"
        android:layout_height="74dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="22dp"
        android:elevation="14dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.92">

        <LinearLayout
            android:id="@+id/routeInfoContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginEnd="12dp"
            android:gravity="center_vertical"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/startNavigationContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvRouteTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/inter_black"
                android:maxLines="2"
                android:text="Destination"
                android:textColor="@color/black"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvRouteMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="@font/inter_bold"
                android:maxLines="1"
                android:text="0 m - 0 min"
                android:textColor="@color/black"
                android:textSize="13sp" />

        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/startNavigationContainer"
            android:layout_width="112dp"
            android:layout_height="46dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.example.gnssandopticalflowapp.util.liquidglass.widget.LiquidGlassView
                android:id="@+id/startNavigationBubble"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:round="40dp" />

            <TextView
                android:id="@+id/btnStartNavigation"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:fontFamily="@font/inter_semi_bold"
                android:gravity="center"
                android:text="Start"
                android:textColor="@color/black"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="@id/startNavigationBubble"
                app:layout_constraintEnd_toEndOf="@id/startNavigationBubble"
                app:layout_constraintStart_toStartOf="@id/startNavigationBubble"
                app:layout_constraintTop_toTopOf="@id/startNavigationBubble" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.example.gnssandopticalflowapp.util.liquidglass.widget.LiquidGlassView
        android:id="@+id/currentLocationBubble"
        android:layout_width="44dp"
        android:layout_height="44dp"
        app:layout_constraintBottom_toBottomOf="@id/icPin"
        app:layout_constraintEnd_toEndOf="@id/icPin"
        app:layout_constraintStart_toStartOf="@id/icPin"
        app:layout_constraintTop_toTopOf="@id/icPin"
        app:round="40dp" />

    <androidx.constraintlayout.utils.widget.ImageFilterView
        android:id="@+id/currentLocationBubbleNormal"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/bg_map_pin_glass"
        app:layout_constraintBottom_toBottomOf="@id/icPin"
        app:layout_constraintEnd_toEndOf="@id/icPin"
        app:layout_constraintStart_toStartOf="@id/icPin"
        app:layout_constraintTop_toTopOf="@id/icPin"
        app:layout_goneMarginBottom="30dp"
        app:round="40dp" />

    <ImageView
        android:id="@+id/icPin"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:padding="13dp"
        android:src="@drawable/ic_pin"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_goneMarginBottom="30dp"
        app:tint="@color/black" />

    <androidx.constraintlayout.utils.widget.ImageFilterView
        android:id="@+id/arBubble"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="18dp"
        android:layout_marginBottom="16dp"
        android:src="@drawable/bg_map_pin_glass"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_goneMarginBottom="30dp"
        app:round="40dp" />

    <ImageView
        android:id="@+id/icAr"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:padding="8dp"
        android:src="@drawable/ic_ar"
        app:layout_constraintBottom_toBottomOf="@id/arBubble"
        app:layout_constraintEnd_toEndOf="@id/arBubble"
        app:layout_constraintStart_toStartOf="@id/arBubble"
        app:layout_constraintTop_toTopOf="@id/arBubble"
        app:tint="@color/white" />

    <ImageView
        android:id="@+id/mapTargetCenterIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:elevation="18dp"
        android:src="@drawable/ic_target_location"
        android:translationY="-24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.example.gnssandopticalflowapp.util.liquidglass.widget.LiquidGlassView
        android:id="@+id/backBubble"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/icClose"
        app:layout_constraintEnd_toEndOf="@id/icClose"
        app:layout_constraintStart_toStartOf="@id/icClose"
        app:layout_constraintTop_toTopOf="@id/icClose"
        app:round="40dp" />

    <ImageView
        android:id="@+id/icClose"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="38dp"
        android:padding="13dp"
        android:src="@drawable/ic_close"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_goneMarginBottom="30dp"/>

    <com.example.gnssandopticalflowapp.util.liquidglass.widget.LiquidGlassView
        android:id="@+id/checkBubble"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/icCheck"
        app:layout_constraintEnd_toEndOf="@id/icCheck"
        app:layout_constraintStart_toStartOf="@id/icCheck"
        app:layout_constraintTop_toTopOf="@id/icCheck"
        app:round="40dp" />

    <ImageView
        android:id="@+id/icCheck"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="38dp"
        android:padding="6dp"
        android:tint="@color/black"
        android:src="@drawable/ic_check"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_goneMarginBottom="30dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
