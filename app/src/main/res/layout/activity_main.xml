<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".MainActivity">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:defaultNavHost="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navGraph="@navigation/nav_graph" />

    <View
        android:id="@+id/loadingCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/bg_modal_glass"
        android:elevation="24dp"
        android:visibility="gone"
        app:layout_constraintDimensionRatio="2:0.5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.92" />

    <ProgressBar
        android:id="@+id/progress_circular"
        style="@style/Widget.AppCompat.ProgressBar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="20dp"
        android:elevation="25dp"
        android:indeterminate="true"
        android:indeterminateTint="#DCCBFF"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/loadingCard"
        app:layout_constraintStart_toStartOf="@id/loadingCard"
        app:layout_constraintTop_toTopOf="@id/loadingCard"
        app:layout_constraintVertical_bias="0.52" />

    <TextView
        android:id="@+id/tvLoadingMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:elevation="25dp"
        android:ellipsize="end"
        android:fontFamily="@font/inter_black"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:text="Processing..."
        android:textColor="@color/white"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/progress_circular"
        app:layout_constraintEnd_toStartOf="@id/actionGroup"
        app:layout_constraintStart_toEndOf="@id/progress_circular"
        app:layout_constraintTop_toTopOf="@id/progress_circular" />

    <LinearLayout
        android:id="@+id/actionGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:elevation="25dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@id/loadingCard"
        app:layout_constraintEnd_toEndOf="@id/loadingCard"
        app:layout_constraintTop_toTopOf="@id/loadingCard">

        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/bg_glass_chip"
            android:fontFamily="@font/inter_black"
            android:gravity="center"
            android:minWidth="112dp"
            android:paddingHorizontal="14dp"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnLater"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/inter_black"
            android:gravity="center"
            android:minWidth="112dp"
            android:text="Later"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivClose"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/bg_glass_icon_button"
        android:contentDescription="Collapse"
        android:elevation="26dp"
        android:padding="6dp"
        android:src="@drawable/ic_close"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/loadingCard"
        app:layout_constraintTop_toTopOf="@id/loadingCard"
        app:tint="@color/white" />

    <FrameLayout
        android:id="@+id/processingBubble"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginTop="104dp"
        android:layout_marginEnd="20dp"
        android:clickable="true"
        android:contentDescription="Processing"
        android:focusable="true"
        android:elevation="26dp"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivNoti"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_modal_glass"
            android:padding="10dp"
            android:src="@drawable/ic_noti" />

        <View
            android:id="@+id/processingDoneDot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_processing_done_dot"
            android:visibility="gone" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
