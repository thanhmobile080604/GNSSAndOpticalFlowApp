<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D905030A">

    <View
        android:id="@+id/loadingCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_modal_glass"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="280:210"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.72" />

    <TextView
        android:id="@+id/tvLoadingMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="16dp"
        android:ellipsize="end"
        android:fontFamily="@font/inter_black"
        android:gravity="center"
        android:maxLines="1"
        android:text="Processing..."
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@id/progress_circular"
        app:layout_constraintEnd_toEndOf="@id/loadingCard"
        app:layout_constraintStart_toStartOf="@id/loadingCard" />

    <ProgressBar
        android:id="@+id/progress_circular"
        style="@style/Widget.AppCompat.ProgressBar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:indeterminateTint="#DCCBFF"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="@id/loadingCard"
        app:layout_constraintEnd_toEndOf="@id/loadingCard"
        app:layout_constraintStart_toStartOf="@id/loadingCard"
        app:layout_constraintTop_toTopOf="@id/loadingCard"
        app:layout_constraintVertical_bias="0.52" />

    <TextView
        android:id="@+id/btnCancel"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_glass_chip"
        android:fontFamily="@font/inter_black"
        android:gravity="center"
        android:minWidth="112dp"
        android:paddingHorizontal="24dp"
        android:text="Cancel"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:translationZ="100dp"
        app:layout_constraintEnd_toEndOf="@id/progress_circular"
        app:layout_constraintStart_toStartOf="@id/progress_circular"
        app:layout_constraintTop_toBottomOf="@id/progress_circular" />

</androidx.constraintlayout.widget.ConstraintLayout>
