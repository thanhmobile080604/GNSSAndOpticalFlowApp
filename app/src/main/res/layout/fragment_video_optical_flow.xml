<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main">

    <ImageView
        android:id="@+id/ivBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="38dp"
        android:background="@drawable/bg_glass_icon_button"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:padding="12dp"
        android:scaleX="-1"
        android:src="@drawable/ic_arrow_right"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white" />

    <TextView
        android:id="@+id/tvVideoDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="18dp"
        android:ellipsize="end"
        android:fontFamily="@font/inter_black"
        android:maxLines="1"
        android:textColor="@color/white"
        android:textSize="19sp"
        app:layout_constraintBottom_toBottomOf="@id/ivBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/ivBack"
        app:layout_constraintTop_toTopOf="@id/ivBack"
        tools:text="19:40 26/11/2025" />

    <ImageView
        android:id="@+id/ivFullScreen"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="22dp"
        android:src="@drawable/ic_full_screen"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/ivBack"
        app:layout_constraintBottom_toBottomOf="@id/ivBack"
        app:tint="@color/white" />

    <androidx.constraintlayout.utils.widget.ImageFilterView
        android:id="@+id/bgGlass"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:round="20dp"
        android:src="@drawable/bg_glass_card"
        android:layout_marginTop="-2dp"
        android:layout_marginBottom="-2dp"
        android:layout_marginStart="-2dp"
        android:layout_marginEnd="-2dp"
        app:layout_constraintTop_toTopOf="@id/videoGroup"
        app:layout_constraintBottom_toBottomOf="@id/videoGroup"
        app:layout_constraintEnd_toEndOf="@id/videoGroup"
        app:layout_constraintStart_toStartOf="@id/videoGroup"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/videoGroup"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@android:color/black"
        app:cardCornerRadius="22dp"
        app:cardElevation="16dp"
        app:layout_constraintBottom_toTopOf="@id/controlPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivBack">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.media3.ui.AspectRatioFrameLayout
                android:id="@+id/aspectRatioFrameLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:resize_mode="fill">

                <TextureView
                    android:id="@+id/videoView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <ImageView
                    android:id="@+id/ivRender"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

            </androidx.media3.ui.AspectRatioFrameLayout>

        </FrameLayout>

    </androidx.cardview.widget.CardView>

    <View
        android:id="@+id/controlPanel"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_video_control_panel"
        android:elevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/ivVideoControl"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="18dp"
        android:background="@drawable/bg_glass_icon_button"
        android:padding="12dp"
        android:src="@drawable/ic_pause_video"
        app:layout_constraintBottom_toBottomOf="@id/controlPanel"
        app:layout_constraintStart_toStartOf="@id/controlPanel"
        app:layout_constraintTop_toTopOf="@id/controlPanel"
        app:tint="@color/white" />

    <SeekBar
        android:id="@+id/videoProgress"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="18dp"
        android:max="100"
        android:maxHeight="7dp"
        android:minHeight="7dp"
        android:progress="0"
        android:progressDrawable="@drawable/seekbar_glass_purple"
        android:thumb="@drawable/ripple_glow_purple_thumb"
        app:layout_constraintEnd_toEndOf="@id/controlPanel"
        app:layout_constraintStart_toEndOf="@+id/ivVideoControl"
        app:layout_constraintTop_toTopOf="@id/ivVideoControl"
        app:layout_constraintBottom_toBottomOf="@id/ivVideoControl"/>

    <TextView
        android:id="@+id/tvTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="22dp"
        android:fontFamily="@font/inter_extra_bold"
        android:text="00:00/00:00"
        android:textColor="#E7DEFF"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="@id/controlPanel"
        app:layout_constraintTop_toBottomOf="@id/videoProgress" />

</androidx.constraintlayout.widget.ConstraintLayout>
