<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main">

    <ImageView
        android:id="@+id/ivBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="38dp"
        android:background="@drawable/bg_glass_icon_button"
        android:padding="12dp"
        android:scaleX="-1"
        android:src="@drawable/ic_arrow_right"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="16dp"
        android:ellipsize="end"
        android:fontFamily="@font/inter_black"
        android:maxLines="1"
        android:text="Optical Flow"
        android:textColor="@color/white"
        android:textSize="25sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/ivBack"
        app:layout_constraintTop_toTopOf="@id/ivBack" />

    <androidx.constraintlayout.utils.widget.ImageFilterView
        android:id="@+id/bgGlass"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="18dp"
        android:src="@drawable/bg_camera_glass_frame"
        app:layout_constraintDimensionRatio="398:430"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivBack"
        app:layout_constraintWidth_percent="0.93"
        app:round="20dp" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cvCamera"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="2dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="28.6dp"
        app:cardUseCompatPadding="false"
        app:layout_constraintBottom_toBottomOf="@id/bgGlass"
        app:layout_constraintEnd_toEndOf="@id/bgGlass"
        app:layout_constraintStart_toStartOf="@id/bgGlass"
        app:layout_constraintTop_toTopOf="@id/bgGlass">

        <androidx.camera.view.PreviewView
            android:id="@+id/camera_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:implementationMode="compatible"
            app:scaleType="fillCenter" />

        <ImageView
            android:id="@+id/camera_output_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <com.example.gnssandopticalflowapp.view.RoiOverlayView
            android:id="@+id/roiOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvTimer"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="14dp"
            android:visibility="gone"
            android:background="@drawable/bg_timer_chip"
            android:fontFamily="@font/inter_extra_bold"
            android:gravity="center"
            android:minWidth="74dp"
            android:paddingHorizontal="12dp"
            android:text="00:00"
            android:textColor="@color/white"
            android:textSize="13sp" />

    </androidx.cardview.widget.CardView>

    <View
        android:id="@+id/bgGlassBottom"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_glass_panel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cvCamera"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/bottomPanelCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="10dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:cardUseCompatPadding="false"
        app:layout_constraintTop_toTopOf="@id/bgGlassBottom"
        app:layout_constraintBottom_toBottomOf="@id/bgGlassBottom"
        app:layout_constraintStart_toStartOf="@id/bgGlassBottom"
        app:layout_constraintEnd_toEndOf="@id/bgGlassBottom">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/bottomPanelContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/topControlRow"
                android:layout_width="match_parent"
                android:layout_height="78dp"
                android:background="@drawable/bg_glass_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/motion_vector_card"
                    android:layout_width="66dp"
                    android:layout_height="66dp"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:cardUseCompatPadding="false">

                    <ImageView
                        android:id="@+id/motion_vector"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop" />

                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical">


                    <TextView
                        android:id="@+id/vel_pred"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter_black"
                        android:maxLines="1"
                        android:text="0.00"
                        android:textColor="@color/white"
                        android:textSize="25sp"
                        tools:text="1.24" />

                    <TextView
                        android:id="@+id/movingType"
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:layout_marginTop="1dp"
                        android:background="@drawable/bg_status_chip"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter_bold"
                        android:gravity="center"
                        android:maxLines="1"
                        android:minWidth="86dp"
                        android:paddingHorizontal="9dp"
                        android:text="Stand Still"
                        android:textColor="#E7DEFF"
                        android:textSize="11sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/update_features_button"
                    android:layout_width="122dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_gradient_update_button"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter_black"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingHorizontal="12dp"
                    android:text="Start Analysis"
                    android:textColor="@color/white"
                    android:textSize="10sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/modePanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/algorithmCard"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_glass_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <TextView
                        android:id="@+id/ofAlgorithm"
                        android:layout_width="88dp"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter_black"
                        android:maxLines="1"
                        android:text="KLT"
                        android:textColor="@color/white"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/btnAlgorithmKlt"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_gradient_update_button_12"
                        android:fontFamily="@font/inter_black"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="KLT"
                        android:textColor="@color/white"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/btnAlgorithmFarneback"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_glass_chip"
                        android:fontFamily="@font/inter_black"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="Farneback"
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/farnebackViewCard"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_glass_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <TextView
                        android:id="@+id/tvFarnebackViewLabel"
                        android:layout_width="88dp"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter_black"
                        android:maxLines="1"
                        android:text="Display"
                        android:textColor="@color/white"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/btnFarnebackVectors"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_gradient_update_button_12"
                        android:fontFamily="@font/inter_black"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="Vector"
                        android:textColor="@color/white"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/btnFarnebackHeatmap"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_glass_chip"
                        android:fontFamily="@font/inter_black"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="Heatmap"
                        android:textColor="@color/white"
                        android:textSize="13sp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/motionCard"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_glass_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <TextView
                        android:id="@+id/tvMotionStateLabel"
                        android:layout_width="88dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_black"
                        android:text="Motion"
                        android:textColor="@color/white"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/btnMotionAuto"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_gradient_update_button_12"
                        android:fontFamily="@font/inter_black"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="Auto"
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/btnMotionStill"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginHorizontal="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_glass_chip"
                        android:fontFamily="@font/inter_black"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="Still"
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/btnMotionMoving"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_glass_chip"
                        android:fontFamily="@font/inter_black"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="Move"
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/roiCard"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_glass_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <TextView
                        android:id="@+id/tvRoiLabel"
                        android:layout_width="88dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_black"
                        android:text="ROI"
                        android:textColor="@color/white"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/btnRoiSelect"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_glass_chip"
                        android:fontFamily="@font/inter_black"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="Select"
                        android:textColor="@color/white"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/btnRoiFull"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_gradient_update_button_12"
                        android:fontFamily="@font/inter_black"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="Full"
                        android:textColor="@color/white"
                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/seekbarPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp">

                <TextView
                    android:id="@+id/tvSensitivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_extra_bold"
                    android:text="Sensitivity"
                    android:textColor="@color/white"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/sensitivity_bar"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginTop="4dp"
                    android:max="100"
                    android:maxHeight="7dp"
                    android:minHeight="7dp"
                    android:progress="50"
                    android:progressDrawable="@drawable/seekbar_glass_purple"
                    android:thumb="@drawable/ripple_glow_purple_thumb" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/recordPanel"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_record_panel"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:id="@+id/ivVideRecord"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_start_record_purple" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvRecordTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter_black"
                        android:maxLines="1"
                        android:text="Record Optical Flow"
                        android:textColor="@color/white"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvRecordSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter_medium"
                        android:maxLines="1"
                        android:text="Tap to capture and process"
                        android:textColor="#BDAEE5"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
