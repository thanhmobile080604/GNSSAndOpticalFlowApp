<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_camera_bubble_gradient">

    <ImageView
        android:id="@+id/ivBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="38dp"
        android:background="@drawable/bg_glass_icon_button"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:padding="12dp"
        android:scaleX="-1"
        android:src="@drawable/ic_arrow_right"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="16dp"
        android:ellipsize="end"
        android:fontFamily="@font/inter_black"
        android:maxLines="1"
        android:text="Optical Flow"
        android:textColor="@color/white"
        android:textSize="25sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/ivBack"
        app:layout_constraintTop_toTopOf="@id/ivBack" />

    <TextView
        android:id="@+id/tvCameraMode"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_glass_chip"
        android:fontFamily="@font/inter_extra_bold"
        android:gravity="center"
        android:paddingHorizontal="10dp"
        android:text="Live Camera"
        android:textColor="#DCCBFF"
        android:textSize="11sp"
        app:layout_constraintStart_toEndOf="@id/ivBack"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <androidx.constraintlayout.utils.widget.ImageFilterView
        android:id="@+id/bgGlass"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:round="20dp"
        android:layout_marginTop="18dp"
        android:src="@drawable/bg_camera_glass_frame"
        app:layout_constraintDimensionRatio="398:430"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivBack"
        app:layout_constraintWidth_percent="0.93"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/cvCamera"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="34dp"
        android:layout_margin="2dp"
        app:cardUseCompatPadding="false"
        app:layout_constraintTop_toTopOf="@id/bgGlass"
        app:layout_constraintBottom_toBottomOf="@id/bgGlass"
        app:layout_constraintEnd_toEndOf="@id/bgGlass"
        app:layout_constraintStart_toStartOf="@id/bgGlass">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="2dp">

            <androidx.camera.view.PreviewView
                android:id="@+id/camera_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:implementationMode="compatible"
                app:scaleType="fillCenter" />

            <ImageView
                android:id="@+id/camera_output_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <View
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:layout_gravity="top"
                android:background="@drawable/bg_camera_top_scrim" />

            <TextView
                android:id="@+id/tvTimer"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_timer_chip"
                android:fontFamily="@font/inter_extra_bold"
                android:gravity="center"
                android:minWidth="74dp"
                android:paddingHorizontal="12dp"
                android:text="00:00"
                android:textColor="@color/white"
                android:textSize="13sp" />

        </FrameLayout>

    </androidx.cardview.widget.CardView>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/bottomPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_glass_panel"
        android:clipToPadding="false"
        android:elevation="12dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cvCamera">

        <LinearLayout
            android:id="@+id/bottomPanelContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:id="@+id/topControlRow"
                android:layout_width="match_parent"
                android:layout_height="78dp"
                android:background="@drawable/bg_glass_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <androidx.constraintlayout.utils.widget.ImageFilterView
                    android:id="@+id/motion_vector"
                    android:layout_width="66dp"
                    android:layout_height="66dp"
                    android:background="@drawable/bg_motion_preview"
                    android:padding="8dp"
                    app:round="22dp"
                    app:srcCompat="@drawable/ic_optical_flow" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvVelocityLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter_extra_bold"
                        android:maxLines="1"
                        android:text="Velocity"
                        android:textColor="#BFAAFF"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/vel_pred"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter_black"
                        android:maxLines="1"
                        android:text="0.00"
                        android:textColor="@color/white"
                        android:textSize="25sp"
                        tools:text="1.24" />

                    <TextView
                        android:id="@+id/movingType"
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:layout_marginTop="1dp"
                        android:background="@drawable/bg_status_chip"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter_bold"
                        android:gravity="center"
                        android:maxLines="1"
                        android:minWidth="86dp"
                        android:paddingHorizontal="9dp"
                        android:text="Stand Still"
                        android:textColor="#E7DEFF"
                        android:textSize="11sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/update_features_button"
                    android:layout_width="96dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_gradient_update_button"
                    android:drawableStart="@drawable/ic_refresh_24"
                    android:drawablePadding="6dp"
                    android:drawableTint="@color/white"
                    android:fontFamily="@font/inter_black"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="Update"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/switchPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/algorithmCard"
                    android:layout_width="0dp"
                    android:layout_height="86dp"
                    android:layout_marginEnd="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_glass_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="8dp">

                    <TextView
                        android:id="@+id/tvAlgorithmLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_bold"
                        android:text="Algorithm"
                        android:textColor="#A999D8"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/ofAlgorithm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter_black"
                        android:maxLines="1"
                        android:text="KLT"
                        android:textColor="@color/white"
                        android:textSize="15sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/ofType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:splitTrack="false"
                        app:switchMinWidth="48dp"
                        app:thumbTint="@color/switch_thumb_selector"
                        app:trackTint="@color/switch_track_selector" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/testCard"
                    android:layout_width="0dp"
                    android:layout_height="86dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_glass_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="8dp">

                    <TextView
                        android:id="@+id/Test"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_bold"
                        android:text="Mode"
                        android:textColor="#A999D8"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvManualLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/inter_black"
                        android:text="Manual"
                        android:textColor="@color/white"
                        android:textSize="15sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/testType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:splitTrack="false"
                        app:switchMinWidth="48dp"
                        app:thumbTint="@color/switch_thumb_selector"
                        app:trackTint="@color/switch_track_selector" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/movingCard"
                    android:layout_width="0dp"
                    android:layout_height="86dp"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_glass_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="8dp">

                    <TextView
                        android:id="@+id/tvMovingLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_bold"
                        android:text="Motion"
                        android:textColor="#A999D8"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvMotionStateLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/inter_black"
                        android:text="Moving"
                        android:textColor="@color/white"
                        android:textSize="15sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/movingStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:splitTrack="false"
                        app:switchMinWidth="48dp"
                        app:thumbTint="@color/switch_thumb_selector"
                        app:trackTint="@color/switch_track_selector" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/seekbarPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp">

                <TextView
                    android:id="@+id/tvKltSensitivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_extra_bold"
                    android:text="KLT Sensitivity"
                    android:textColor="@color/white"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/klt_sensitivity_bar"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginTop="4dp"
                    android:max="100"
                    android:maxHeight="7dp"
                    android:minHeight="7dp"
                    android:progress="50"
                    android:progressDrawable="@drawable/seekbar_glass_purple"
                    android:thumb="@drawable/ripple_glow_purple_thumb" />

                <TextView
                    android:id="@+id/tvFarnebackSensitivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/inter_extra_bold"
                    android:text="Farneback Sensitivity"
                    android:textColor="@color/white"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/farneback_sensitivity_bar"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginTop="4dp"
                    android:max="100"
                    android:maxHeight="7dp"
                    android:minHeight="7dp"
                    android:progress="50"
                    android:progressDrawable="@drawable/seekbar_glass_purple"
                    android:thumb="@drawable/ripple_glow_purple_thumb" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/recordPanel"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_record_panel"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:id="@+id/ivVideRecord"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:background="@drawable/bg_record_button_glow"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_start_record_purple" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvRecordTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter_black"
                        android:maxLines="1"
                        android:text="Record Optical Flow"
                        android:textColor="@color/white"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvRecordSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter_medium"
                        android:maxLines="1"
                        android:text="Tap to capture and process"
                        android:textColor="#BDAEE5"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
