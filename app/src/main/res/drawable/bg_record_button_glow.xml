<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#44FFFFFF">
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <gradient
                        android:angle="315"
                        android:endColor="#FF4ED8"
                        android:startColor="#7B5CFF" />
                </shape>
            </item>
            <item
                android:bottom="6dp"
                android:left="6dp"
                android:right="6dp"
                android:top="6dp">
                <shape android:shape="oval">
                    <solid android:color="#26FFFFFF" />
                    <stroke
                        android:width="1dp"
                        android:color="#66FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
