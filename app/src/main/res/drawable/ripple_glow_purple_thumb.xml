<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#44FF4ED8">
    <item>
        <shape android:shape="oval">
            <size
                android:width="22dp"
                android:height="22dp" />
            <gradient
                android:angle="315"
                android:endColor="#FF4ED8"
                android:startColor="#8A5CFF" />
            <stroke
                android:width="2dp"
                android:color="#E6FFFFFF" />
        </shape>
    </item>
</ripple>
